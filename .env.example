# .env.example — copy to .env and fill in values
# The web UI form is the recommended way to supply credentials at runtime.
# These env vars are only used if you run copy_trader.py directly (headless mode).

# ── Target ─────────────────────────────────────────────────────────────────
TARGET_WALLET=0x...              # whale wallet to copy-trade

# ── My credentials (NEVER commit the real .env to git) ─────────────────────
PRIVATE_KEY=0x...                # your EOA private key
MY_WALLET=                       # leave blank to auto-derive from private key
SIGNATURE_TYPE=0                 # 0=EOA (default), 1=Magic/Email, 2=Proxy
FUNDER_ADDRESS=                  # only needed for sig_type 1 or 2

# ── Risk controls ───────────────────────────────────────────────────────────
COPY_MULTIPLIER=0.10             # 10% of their trade size
MAX_USD_PER_TRADE=50.0           # hard cap per copied order (USDC)
MIN_USD_TO_COPY=5.0              # skip trades worth less than this (USDC)
MAX_TOTAL_EXPOSURE_USD=500.0     # max total open USDC in BTC-5min positions
POLLING_INTERVAL=1.0             # seconds between data-api polls (legacy)
CHAIN_POLL_INTERVAL=0.25         # seconds between blockchain polls (0.25 = ~0.125s avg lag)

# ── Blockchain RPC ──────────────────────────────────────────────────────────
# Free public default: publicnode.com (no key needed)
# For best reliability use a free Alchemy key:
#   https://dashboard.alchemy.com → create app → Polygon Mainnet → copy HTTPS URL
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com

# ── Mode ────────────────────────────────────────────────────────────────────
DRY_RUN=true                     # true = simulate only; false = real orders

# ── Notifications (Sprint 2) ─────────────────────────────────────────────────
NOTIFICATION_METHOD=none         # none | telegram | slack

# Telegram: create bot via @BotFather, get chat_id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack: create an Incoming Webhook in your Slack app settings
SLACK_WEBHOOK_URL=
